# ADB IXRate Checker Configuration

# Interface file folder path
ADB_INTERFACE_FOLDER=

# WebDriver path (leave empty for auto-detect)
ADB_WEBDRIVER_PATH=

# Currencies to check (comma-separated)
ADB_CURRENCIES=CNY,EUR,NZD

# Tolerance for rate comparison
ADB_TOLERANCE=0.001

# Browser mode
ADB_HEADLESS=true

# Logging
ADB_LOG_LEVEL=INFO

# Lag days per currency
ADB_LAG_CNY=1
ADB_LAG_EUR=2
ADB_LAG_NZD=0

# Max fallback days for file search
ADB_MAX_FALLBACK_DAYS=3

# URLs (override only if sources change)
# ADB_SHIBOR_API_URL=https://www.shibor.org/ags/ms/cm-u-bk-shibor/ShiborHis
# ADB_SHIBOR_WEB_URL=https://www.shibor.org/shibor/web/html/shibor.html
# ADB_EURIBOR_URL=https://www.euribor-rates.eu/en/current-euribor-rates/
# ADB_NZFMA_URL=https://www.nzfma.org/data/search.aspx

# Timeouts (seconds)
ADB_PAGE_LOAD_TIMEOUT=30
ADB_WAIT_TIMEOUT=15
ADB_API_REQUEST_TIMEOUT=30
